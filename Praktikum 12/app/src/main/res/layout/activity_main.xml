<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_height="match_parent"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="480dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/textView1"
            android:layout_width="240dp"
            android:layout_height="50dp"
            android:text="@string/masukkan_nama_dan_universitas" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <android.support.design.widget.TextInputLayout
                android:id="@+id/inama"
                android:layout_width="170dp"
                android:layout_height="50dp"
                android:hint="nama">

                <android.support.design.widget.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="nama"
                    android:inputType="text"
                    android:visibility="visible"
                    tools:visibility="invisible" />
            </android.support.design.widget.TextInputLayout>

            <android.support.design.widget.TextInputLayout
                android:id="@+id/isekolah"
                android:layout_width="170dp"
                android:layout_height="50dp"
                android:layout_marginTop="48dp"
                android:layout_marginEnd="24dp"
                android:hint="universitas">

                <android.support.design.widget.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/universitas"
                    android:inputType="text"
                    android:visibility="visible"
                    tools:visibility="invisible" />

            </android.support.design.widget.TextInputLayout>

        </LinearLayout>

        <Button
            android:id="@+id/btambah"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:text="Tambah" />

        <TableLayout
            android:id="@+id/tabel_data"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TableRow
                android:id="@+id/tableRow1"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <TextView
                    android:id="@+id/no_id"
                    android:layout_width="65dp"
                    android:layout_height="50dp"
                    android:text="No" />

                <TextView
                    android:id="@+id/nama_id"
                    android:layout_width="125dp"
                    android:layout_height="50dp"
                    android:text="Nama" />

                <TextView
                    android:id="@+id/universitas_id"
                    android:layout_width="125dp"
                    android:layout_height="50dp"
                    android:text="Universitas" />

            </TableRow>

        </TableLayout>

    </LinearLayout>

</android.support.constraint.ConstraintLayout>